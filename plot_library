<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>คลังพล็อตของฉัน | My Sweet Story</title>
  <style>
    body {
      font-family: "Cordia New", sans-serif;
      background-color: #fffaf3;
      background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP4+fPnfwAI+AN6I2HHzgAAAABJRU5ErkJggg==');
      background-repeat: repeat;
      margin: 0;
      padding: 0;
      color: #5a4632;
    }
    header {
      background-color: #f9e0c3;
      padding: 20px;
      text-align: center;
      font-size: 2rem;
      font-weight: bold;
      color: #8b5e3c;
      box-shadow: 0 3px 6px rgba(0,0,0,0.1);
    }
    main {
      max-width: 850px;
      margin: 30px auto;
      background-color: #fff7ee;
      border-radius: 16px;
      padding: 25px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    h2 {
      color: #a67856;
      border-bottom: 2px dashed #e0c4a8;
      padding-bottom: 5px;
      font-size: 1.4rem;
    }
    .plot-item {
      background-color: #fff;
      border: 1px solid #e4d3c1;
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .plot-info {
      flex: 1;
      margin-right: 15px;
    }
    button {
      background-color: #f4b8b8;
      border: none;
      color: #fff;
      padding: 8px 14px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 1rem;
      margin-left: 6px;
      transition: 0.2s;
    }
    button:hover {
      background-color: #f19c9c;
    }
    .empty {
      text-align: center;
      color: #a67856;
      padding: 40px 0;
      font-size: 1.2rem;
    }
    footer {
      text-align: center;
      margin-top: 20px;
      font-size: 0.9rem;
      color: #8c7760;
    }
  </style>
</head>
<body>
  <header>📚 คลังพล็อตของฉัน</header>
  <main>
    <h2>พล็อตทั้งหมดของฉัน 🍪</h2>
    <div id="plotList" class="plot-list"></div>

    <div style="text-align:center; margin-top:20px;">
      <button onclick="newPlot()">🍰 สร้างพล็อตใหม่</button>
      <button onclick="window.location.href='index.html'">🏠 กลับหน้าหลัก</button>
    </div>
  </main>

  <footer>© 2025 My Sweet Story — Sweet Ideas Bloom Here ✨</footer>

  <script>
    const plotList = document.getElementById("plotList");

    function loadPlots() {
      plotList.innerHTML = "";
      let keys = Object.keys(localStorage).filter(k => k.startsWith("plot_"));
      if (keys.length === 0) {
        plotList.innerHTML = '<div class="empty">ยังไม่มีพล็อตที่บันทึกไว้ 🍪</div>';
        return;
      }

      keys.forEach(k => {
        const p = JSON.parse(localStorage.getItem(k));
        const div = document.createElement("div");
        div.className = "plot-item";
        div.innerHTML = `
          <div class="plot-info">
            <strong>📖 ${p.title || "(ไม่มีชื่อเรื่อง)"}</strong><br>
            <small>บันทึกเมื่อ: ${p.date || "ไม่ระบุ"}</small>
          </div>
          <div>
            <button onclick="openPlot('${k}')">เปิดพล็อต</button>
            <button onclick="deletePlot('${k}')">ลบ</button>
          </div>
        `;
        plotList.appendChild(div);
      });
    }

    function openPlot(key) {
      localStorage.setItem("activePlot", key);
      window.location.href = "plot.html";
    }

    function deletePlot(key) {
      if (confirm("ลบพล็อตนี้แน่ใจไหม?")) {
        localStorage.removeItem(key);
        loadPlots();
      }
    }

    function newPlot() {
      localStorage.removeItem("activePlot");
      window.location.href = "plot.html";
    }

    loadPlots();
  </script>
</body>
</html>
